  ∀f,g,x:compose(f)(g)(x)≡f(g(x))⊢by:definition
  ∀f,x,y:flip(f)(x)(y)≡f(y)(x)⊢by:definition
  ∀x,y:fst(⟨x,y⟩)≡x⊢by:projection
  ∀x,y:snd(⟨x,y⟩)≡y⊢by:projection
}

