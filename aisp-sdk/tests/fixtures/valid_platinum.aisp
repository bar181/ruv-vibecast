}

⟦Λ:Funcs⟧{
  id≜λx.x
  const≜λx.λy.x
  flip≜λf.λx.λy.f(y)(x)
  compose≜λf.λg.λx.f(g(x))
  apply≜λf.λx.f(x)
  curry≜λf.λx.λy.f(⟨x,y⟩)
